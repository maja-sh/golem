# Copy to `.env` and fill in. Values here are loaded by dotenv at boot
# (dev/test only — production releases read the real environment).

# --- Required ---

# Anthropic API key. Get one at https://console.anthropic.com/.
ANTHROPIC_API_KEY=

# --- Jira / Bitbucket integration (required for `golem run --jira`) ---

# Atlassian account email. Same address you log in with.
JIRA_EMAIL=

# Atlassian API token. Generate at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
# Scopes needed: read:jira-work, write:jira-work
JIRA_API_TOKEN=

# Bitbucket app password. Generate at:
#   https://bitbucket.org/account/settings/app-passwords/
# Scopes needed: Repositories Read+Write, Pull requests Write
BITBUCKET_API_TOKEN=

# --- Optional ---

# Perplexity API key. Required if you want the agent to use web_search.
# https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Git author identity inside the container. Defaults to "Golem Bot"
# / "golem@bot.local" if unset.
GIT_USER=
GIT_EMAIL=
