# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
golem-*.tar

# Built escript binary (mix escript.build).
/golem

# Screenshots captured during runs
/screenshots/

# Environment variables
.env

# Agent logs
/logs/

# Saved run state (for resume)
/runs/

# Exported output
/output/

# Bot SSH keys (private keys must never be committed)
/ssh/

# Service account keys and other secrets
/secrets/

# Project-specific config (org-specific settings, credentials)
# Note: ignore the contents, not the directory itself, so we can
# re-include template files below.
.golem/*
# …but track *.example.yml files as committed templates
!.golem/*.example.yml

